<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.diegosoriarios.LiteStudio</id>
  <name>Lite Studio</name>
  <summary>Lightweight project-aware code viewer and editor</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <developer id="io.github.diegosoriarios">
    <name>Diego</name>
  </developer>
  <description>
    <p>
      Lite Studio is a fast, lightweight code viewer and editor built with Qt 6
      and QScintilla. It opens a folder, indexes it safely (including symlinked
      trees), and offers tabs, syntax highlighting, project-wide search, Quick
      Open, Git diffs, an embedded terminal, and optional Android and iOS build
      panels.
    </p>
    <p>
      It is designed to stay small and dependency-light: no language server, no
      background file watcher, and no indexing daemon.
    </p>
  </description>
  <launchable type="desktop-id">io.github.diegosoriarios.LiteStudio.desktop</launchable>
